{
  "manifest_version": 3,
  "name": "Markdown Viewer — Enriched",
  "version": "1.0.0",
  "description": "Render .md files beautifully with great typography, syntax highlighting, math, diagrams and a table of contents. Toggle back to raw anytime.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Markdown Viewer",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["src/detect.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-view": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Toggle between enriched and raw markdown"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/*", "fonts/*", "vendor/*", "vendor/fonts/*", "icons/*"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ]
}
